DATABASE_URL=postgres://user:password@localhost:5432/yesfuture
RPC_URL=https://polygon-rpc.com
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# block the contract was deployed at — indexer starts here on first run
DEPLOY_BLOCK=0
PORT=4000
# blocks per eth_getLogs batch
LOG_BATCH_SIZE=2000
# ms between polls for new blocks once caught up
POLL_INTERVAL_MS=5000
